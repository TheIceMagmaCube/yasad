{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-plugin/types"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts"
  ]
}
