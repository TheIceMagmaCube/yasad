// Cloudflare Workers target. The Docker target is src/server.ts.
{
  "name": "yasad",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: a link check on the Worker's own zone goes out through the edge, never to the origin.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Link checks, every minute. The Free plan allows 5 cron triggers per account, shared by all its Workers.
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yasad",
      // Replace with the id printed by `wrangler d1 create yasad`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
