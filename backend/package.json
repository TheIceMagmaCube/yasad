{
  "name": "@yasad/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "wrangler dev",
    "build": "node scripts/build-server.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:workers",
    "test:node": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.10",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
